{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathviz.dev/schemas/common/v1",
  "title": "MathViz common definitions (v1)",
  "description": "Shared building blocks for all MathViz contracts. Frozen in P0. Exact math values are strings (int/rational/symbolic AST); plain JSON numbers are allowed only for presentation-level fields (viewport, timeline seconds, style), never for mathematical facts.",
  "$defs": {
    "Identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
    },
    "VersionString": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.-]+)?$"
    },
    "CapabilityId": {
      "type": "string",
      "pattern": "^(geometry2d|function2d|motion1d)\\.[a-z][a-z0-9_]*$",
      "description": "Stable capability ID from the frozen registry, e.g. geometry2d.rotate_point, motion1d.meeting_event. Never natural language."
    },
    "MathRefStrict": {
      "type": "string",
      "pattern": "^(entity|fact|param|runtime):[A-Za-z_][A-Za-z0-9_-]*$",
      "description": "Reference to a Math IR object by kind-qualified id, e.g. fact:v_A, entity:A, param:theta, runtime:pos_E."
    },
    "ExactInt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "int" },
        "value": { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)$" }
      }
    },
    "ExactRational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "p", "q"],
      "properties": {
        "kind": { "const": "rational" },
        "p": { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)$" },
        "q": { "type": "string", "pattern": "^[1-9][0-9]*$" }
      }
    },
    "ExprNum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "v"],
      "properties": {
        "t": { "const": "num" },
        "v": {
          "oneOf": [
            { "$ref": "#/$defs/ExactInt" },
            { "$ref": "#/$defs/ExactRational" }
          ]
        }
      }
    },
    "ExprSym": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "name"],
      "properties": {
        "t": { "const": "sym" },
        "name": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$" }
      }
    },
    "ExprApp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "op", "args"],
      "properties": {
        "t": { "const": "app" },
        "op": {
          "enum": ["+", "-", "*", "/", "^", "neg", "sin", "cos", "tan", "asin", "acos", "atan", "exp", "ln", "sqrt", "abs"]
        },
        "args": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ExprAst" }
        }
      }
    },
    "ExprAst": {
      "oneOf": [
        { "$ref": "#/$defs/ExprNum" },
        { "$ref": "#/$defs/ExprSym" },
        { "$ref": "#/$defs/ExprApp" }
      ]
    },
    "ExactSymbolic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "expr"],
      "properties": {
        "kind": { "const": "symbolic" },
        "expr": { "$ref": "#/$defs/ExprAst" }
      }
    },
    "ExactNumber": {
      "description": "Exact-first arithmetic value. Decimal rendering happens only at render time; validators use exact semantics.",
      "oneOf": [
        { "$ref": "#/$defs/ExactInt" },
        { "$ref": "#/$defs/ExactRational" },
        { "$ref": "#/$defs/ExactSymbolic" }
      ]
    },
    "SourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "start", "end"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 }
      }
    },
    "ProblemTextProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "span"],
      "properties": {
        "kind": { "const": "problem_text" },
        "span": { "$ref": "#/$defs/SourceSpan" }
      }
    },
    "DerivedProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "capability_id", "inputs"],
      "properties": {
        "kind": { "const": "derived" },
        "capability_id": { "$ref": "#/$defs/CapabilityId" },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/MathRefStrict" }
        }
      }
    }
  }
}
