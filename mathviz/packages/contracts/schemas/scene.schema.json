{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathviz.dev/schemas/scene/v1",
  "title": "Scene IR — expression contract (v1)",
  "description": "The expression layer. Objects NEVER carry mathematical coordinates (no x/y/cx/radius/points/path): additionalProperties:false rejects them at schema level. Real positions come exclusively from bindings into the Verified Math Model, or from renderer-side layout. Only presentation hints (style, label placement anchors, pixel nudges) are allowed here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sceneId", "viewport", "objects", "bindings"],
  "properties": {
    "schemaVersion": { "const": "mathviz.scene/v1" },
    "sceneId": { "$ref": "https://mathviz.dev/schemas/common/v1#/$defs/Identifier" },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "margin": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number", "minimum": 0 }
        }
      }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/VisualObject" }
    },
    "bindings": {
      "type": "array",
      "description": "Additional object-level bindings beyond each object's inline primary binding.",
      "items": { "$ref": "#/$defs/Binding" }
    },
    "layoutRules": {
      "type": "array",
      "items": { "type": "object" },
      "description": "Tightened in P6."
    },
    "teachingGoals": {
      "type": "array",
      "items": { "type": "object" },
      "description": "Tightened in P6."
    }
  },
  "$defs": {
    "StyleObject": {
      "type": "object",
      "additionalProperties": false,
      "description": "Presentation-only style. Closed key set: position-like keys are rejected here too.",
      "properties": {
        "stroke": { "type": "string" },
        "fill": { "type": "string" },
        "stroke_width": { "type": "number", "exclusiveMinimum": 0 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "dash": { "type": "string" },
        "font_size": { "type": "number", "exclusiveMinimum": 0 },
        "font_family": { "type": "string" },
        "weight": { "type": ["string", "number"] },
        "line_cap": { "enum": ["butt", "round", "square"] },
        "z_index": { "type": "integer" }
      }
    },
    "LayoutHint": {
      "type": "object",
      "additionalProperties": false,
      "description": "Renderer layout hint. Screen-space only; never a mathematical value.",
      "properties": {
        "anchor": { "enum": ["n", "ne", "e", "se", "s", "sw", "w", "nw", "center"] },
        "offset_px": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number" }
        },
        "avoid": { "type": "array", "items": { "type": "string" } }
      }
    },
    "VisualObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectId", "primitive", "binding"],
      "properties": {
        "objectId": { "$ref": "https://mathviz.dev/schemas/common/v1#/$defs/Identifier" },
        "primitive": {
          "enum": [
            "point", "segment", "ray", "line", "circle", "arc", "polygon",
            "right_angle_mark", "equal_tick", "parallel_mark", "angle_mark",
            "axis", "grid", "number_line", "function_curve",
            "marker", "moving_body", "trail", "region_highlight",
            "text", "math_text", "brace", "callout", "step_counter",
            "highlight", "dim", "focus_ring"
          ]
        },
        "binding": { "$ref": "#/$defs/Binding" },
        "label": { "type": "string" },
        "label_layout": { "$ref": "#/$defs/LayoutHint" },
        "style": { "$ref": "#/$defs/StyleObject" },
        "text": { "type": "string" },
        "attach_to": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "ObjectIds this object annotates (marks, callouts)."
        }
      }
    },
    "Binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "objectId": {
          "$ref": "https://mathviz.dev/schemas/common/v1#/$defs/Identifier",
          "description": "Required for top-level bindings; must match an existing object (gate G6)."
        },
        "source": {
          "type": "string",
          "pattern": "^math:(entity|fact|param|runtime):[A-Za-z_][A-Za-z0-9_-]*(\\.[A-Za-z_][A-Za-z0-9_-]*)*$",
          "description": "Reference into the Verified Math Model, e.g. math:entity:A.position."
        },
        "attribute": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$"
        },
        "transform": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["screen_offset", "scale", "project"] },
            "params": { "type": "object" }
          }
        }
      }
    }
  }
}
