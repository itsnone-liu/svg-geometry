{
  "name": "mathviz-contracts",
  "version": "0.3.0",
  "private": true,
  "description": "MathViz P0.1 contracts + P1 pure runtime + P2 Geometry2D Verified Program: compile-time domain adapter, runtime snapshots, assertion gate, pinned Geometry DSL kernel oracle. No LLM or per-frame DSL parse.",
  "type": "commonjs",
  "scripts": {
    "gates:p0": "tsx packages/contracts/src/run.ts",
    "gates:p1": "npm run build:player && tsx packages/runtime/src/run-p1.ts",
    "build:player": "vite build --config examples/p1/vite.config.ts",
    "build:player:p2": "node scripts/gen-p2-html.mjs && vite build --config examples/p2/vite.config.ts",
    "gates:p2": "node scripts/gen-p2-html.mjs && vite build --config examples/p2/vite.config.ts && tsx packages/runtime/src/run-p2.ts",
    "build:player:p3": "vite build --config examples/p3/vite.config.ts && node scripts/gen-p3-html.mjs",
    "gates:p3": "npm run build:player:p3 && tsx packages/runtime/src/run-p3.ts",
    "build:player:p4": "vite build --config examples/p4/vite.config.ts && node scripts/gen-p4-html.mjs",
    "gates:p4": "npm run build:player:p4 && tsx packages/runtime/src/run-p4.ts",
    "gates:p50": "tsx packages/spec/src/run.ts",
    "gates:p51": "tsx packages/parser/src/run-g17.ts && tsx packages/parser-benchmark/src/run.ts",
    "gates:g19": "tsx packages/parser/src/run-g17.ts && tsx packages/parser-benchmark/src/run.ts",
    "gates:g19:live": "node scripts/run-live.mjs",
    "benchmark:p53:freeze": "tsx packages/parser-benchmark/src/freeze-v3.ts",
    "gates:p53:freeze-preflight": "tsx packages/parser-benchmark/src/preflight-v3.ts",
    "gates:p53:freeze-preflight:staged": "tsx packages/parser-benchmark/src/preflight-v3.ts --staged",
    "benchmark:p53:freeze-v4": "tsx packages/parser-benchmark/src/freeze-v4.ts --generate",
    "gates:p53:freeze-preflight-v4": "tsx packages/parser-benchmark/src/preflight-v4.ts",
    "gates:p53:freeze-preflight-v4:staged": "tsx packages/parser-benchmark/src/preflight-v4.ts --staged",
    "gates:p53:prereg-preflight-v4": "tsx packages/parser-benchmark/src/preflight-v4.ts --require-prereg",
    "p53:live-v4": "node scripts/run-live-v4.mjs",
    "p53:provider-auth-check": "node scripts/check-provider-auth.mjs",
    "benchmark:p53:replay": "tsx packages/parser-benchmark/src/run-v3.ts --replay",
    "gates:p53:live": "node scripts/run-live-v3.mjs",
    "gates": "npm run gates:p0 && npm run gates:p1 && npm run gates:p2 && npm run gates:p3 && npm run gates:p4 && npm run gates:p50 && npm run gates:p51",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "^8.17.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
